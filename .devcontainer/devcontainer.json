{
  "name": "Vector Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.check.command": "check",
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.procMacro.enable": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "postCreateCommand": "rustup show",
  "remoteUser": "vscode",
  "mounts": [
    "source=vector-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=vector-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=vector-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=vector-claude-data,target=/home/vscode/.claude,type=volume"
  ]
}
